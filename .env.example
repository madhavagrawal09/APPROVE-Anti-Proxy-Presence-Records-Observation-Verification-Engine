# Copy this file to .env for local development.
# Never commit .env or place real credentials in this file.

APP_ENV=development
APP_NAME=APPROVE
LOG_LEVEL=INFO

# Local PostgreSQL example. Replace values in your private .env.
DATABASE_URL=postgresql+psycopg://approve:change-me@localhost:5432/approve

# Generate a strong random value locally before running an application.
# Do not use this placeholder as a real signing or session secret.
APP_SECRET_KEY=replace-with-a-long-random-secret

# Optional. Leave unset until a local Redis instance is configured.
REDIS_URL=

# CORS origins should be explicitly configured per environment.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
